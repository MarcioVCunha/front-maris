{
  "buildCommand": "node scripts/generate-env.js",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "front-maris\\.vercel\\.app" }],
      "destination": "https://lojamaris.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "front-maris\\.vercel\\.app" }],
      "destination": "https://lojamaris.com.br/:path*",
      "permanent": true
    },
    { "source": "/hubs/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/hubs/vendedoras.html", "destination": "/vendedoras", "permanent": true },
    { "source": "/hubs/catalogo.html", "destination": "/catalogo", "permanent": true },
    { "source": "/importJson/import.html", "destination": "/admin/importar", "permanent": true },
    { "source": "/addProduct/add-product.html", "destination": "/admin/adicionar", "permanent": true },
    { "source": "/components/components.html", "destination": "/tipos-produto", "permanent": true },
    { "source": "/promocoes/promocoes.html", "destination": "/admin/promocoes", "permanent": true },
    { "source": "/promocoes", "destination": "/admin/promocoes", "permanent": true },
    { "source": "/contas-vendedoras/contas-vendedoras.html", "destination": "/contas-vendedoras", "permanent": true },
    { "source": "/sales/sales.html", "destination": "/vendas/nova", "permanent": true },
    { "source": "/vendas", "destination": "/vendas/nova", "permanent": true },
    { "source": "/vendedoras", "destination": "/vendas/nova", "permanent": true },
    { "source": "/paginas/vendas/vendas.html", "destination": "/vendas/nova", "permanent": true },
    { "source": "/sales/waitlist.html", "destination": "/lista-espera", "permanent": true },
    { "source": "/catalog/catalog.html", "destination": "/catalog", "permanent": true },
    { "source": "/catalog/carrinho.html", "destination": "/catalog/carrinho", "permanent": true },
    { "source": "/catalog/cesta", "destination": "/catalog", "permanent": true },
    { "source": "/catalog/cesta-compartilhada.html", "destination": "/catalog", "permanent": true },
    { "source": "/staff-gate.html", "destination": "/equipe", "permanent": true },
    { "source": "/home.css", "destination": "/assets/home.css", "permanent": true },
    { "source": "/maris-theme.css", "destination": "/assets/maris-theme.css", "permanent": true },
    { "source": "/maris-internal.css", "destination": "/assets/maris-internal.css", "permanent": true },
    { "source": "/shared/:path*", "destination": "/compartilhado/:path*", "permanent": true },
    { "source": "/adicionar-peca", "destination": "/admin/adicionar", "permanent": true },
    { "source": "/importar", "destination": "/admin/importar", "permanent": true },
    { "source": "/trocas.html", "destination": "/trocas-e-devolucoes", "permanent": true },
    { "source": "/trocas", "destination": "/trocas-e-devolucoes", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://vitals.vercel-insights.com https://viacep.com.br https://brasilapi.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/utils.js", "destination": "/compartilhado/utils.js" },
    { "source": "/api.js", "destination": "/compartilhado/api.js" },
    { "source": "/ui.js", "destination": "/compartilhado/ui.js" },
    { "source": "/cart-resolver.js", "destination": "/compartilhado/cart-resolver.js" },
    { "source": "/staff-auth.js", "destination": "/compartilhado/staff-auth.js" },
    { "source": "/", "destination": "/paginas/catalogo/catalogo.html" },
    { "source": "/inicio", "destination": "/paginas/admin/inicio.html" },
    { "source": "/admin/inicio", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/estoque", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/esgotadas", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/vendas", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/vendedoras", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/peca", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/tipos", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/conjuntos", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/adicionar", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/importar", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/promocoes", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/cupons", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/cadastros", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin/indicacoes", "destination": "/paginas/admin/painel.html" },
    { "source": "/admin", "destination": "/paginas/admin/painel.html" },
    { "source": "/catalogo", "destination": "/paginas/admin/catalogo.html" },
    { "source": "/tipos-produto", "destination": "/paginas/estoque/tipos-produto/tipos-produto.html" },
    { "source": "/contas-vendedoras", "destination": "/paginas/vendedoras/contas.html" },
    { "source": "/vendas/nova", "destination": "/paginas/vendas/nova-venda.html" },
    { "source": "/lista-espera", "destination": "/paginas/vendas/lista-espera.html" },
    { "source": "/catalog", "destination": "/paginas/catalogo/catalogo.html" },
    { "source": "/catalog/carrinho", "destination": "/paginas/catalogo/carrinho.html" },
    { "source": "/catalog/obrigado", "destination": "/paginas/catalogo/obrigado.html" },
    { "source": "/obrigado", "destination": "/paginas/catalogo/obrigado.html" },
    { "source": "/trocas-e-devolucoes", "destination": "/paginas/institucional/trocas-e-devolucoes.html" },
    { "source": "/garantia", "destination": "/paginas/institucional/garantia.html" },
    { "source": "/privacidade", "destination": "/paginas/institucional/privacidade.html" },
    { "source": "/equipe/nova-senha", "destination": "/paginas/admin/nova-senha.html" },
    { "source": "/equipe", "destination": "/paginas/admin/equipe.html" },
    { "source": "/entrar", "destination": "/paginas/conta/entrar.html" },
    { "source": "/criar-conta", "destination": "/paginas/conta/criar-conta.html" },
    { "source": "/esqueci-senha", "destination": "/paginas/conta/esqueci-senha.html" },
    { "source": "/redefinir-senha", "destination": "/paginas/conta/redefinir-senha.html" },
    { "source": "/minha-conta", "destination": "/paginas/conta/minha-conta.html" }
  ]
}
